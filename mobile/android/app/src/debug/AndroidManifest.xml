<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the main manifest only for debug builds — adds the cleartext
  exception (network_security_config.xml, same source set) needed to reach
  the local Firebase Emulator Suite. Never applies to a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
