rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // users/{userId} doc id == auth uid, created at sign-up.
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.role in ['customer', 'driver', 'vendor'];
      // Role is fixed at sign-up; only profile fields may change afterwards.
      allow update: if isSelf(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // vendors/{vendorId} — public storefront. Owners manage their own
    // storefront details but can't self-approve; only an admin can move
    // approvalStatus out of 'pending'. New vendors always start pending
    // (enforced at signup by AuthService.signUp, and at write-time here).
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.approvalStatus == 'pending';
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.approvalStatus == resource.data.approvalStatus) ||
        (hasRole('admin') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus']))
      );
      allow delete: if false;

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isSignedIn() &&
          get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid;
      }
    }

    // drivers/{driverId} doc id == auth uid. Availability/location visible
    // to any signed-in user (needed for live order tracking); editable only
    // by the driver themself.
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(driverId);
      allow delete: if false;
    }

    // orders/{orderId} — visible to the customer who placed it, the vendor
    // that owns it, the driver assigned to deliver it, and (for the unclaimed
    // "readyForPickup" queue only) any signed-in driver browsing for work.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid ||
        (resource.data.status == 'readyForPickup' && resource.data.driverId == null && hasRole('driver')) ||
        hasRole('admin')
      );

      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

      // Status transitions before a driver is assigned are handled by the
      // vendor; driver assignment itself goes through the `acceptDelivery`
      // callable Cloud Function (admin SDK, runs a transaction), not a
      // direct client write, so no client-side driver-assignment rule exists here.
      //
      // A customer may additionally cancel their own order, but only while
      // it's still 'pending' (the vendor hasn't acted on it yet) and only
      // the status field — this is race-safe without a callable because
      // Firestore evaluates each write's rules against the document state
      // at the moment that write is applied, so a customer's cancel loses
      // cleanly to a vendor's concurrent accept once status != 'pending'.
      allow update: if isSignedIn() && (
        get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid ||
        (resource.data.customerId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      allow delete: if false;
    }
  }
}
